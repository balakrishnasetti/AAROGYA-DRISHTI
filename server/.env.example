NODE_ENV=development
# Keep demo fixtures and development OTP disabled unless explicitly needed.
DEPLOYMENT_ENV=development
SEED_DEMO=false
MODEL_VALIDATED=false
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/aarogya_drishti
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-string-of-at-least-32-characters
SEED_STAFF_PASSWORD=
CLIENT_URL=http://localhost:5173

# Optional AI and provider integrations; keep secrets server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Local trained-model service; use the same local-only token in both services.
ORAL_MODEL_API_URL=http://127.0.0.1:8000
ORAL_MODEL_API_TOKEN=
ORAL_MODEL_VERSION=
# Do not enable until an independently evaluated model bundle and calibration manifest are approved.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Private local disk storage for development (files are not exposed as static assets).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./private-storage
# For MinIO/S3 instead, set STORAGE_BACKEND=s3 plus endpoint, bucket, region, and credentials.
STORAGE_ENDPOINT=
STORAGE_BUCKET=aarogya-private-photos
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Optional Google Maps Directions API key; server-only, never expose as VITE_*.
MAPS_KEY=
SMS_PROVIDER=
SMS_API_KEY=
SMS_TEMPLATE_ID=
SMS_SENDER_ID=
# Local development only: show patient registration OTP in the browser instead of sending SMS.
DEV_PATIENT_REGISTRATION_OTP=false
# Optional Cloudflare Turnstile; configure both values to enable CAPTCHA after repeated OTP failures.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# ABDM ABHA sign-in. Keep client credentials server-side; production URLs must come from ABDM onboarding.
ABDM_ENABLED=false
ABDM_ENVIRONMENT=sandbox
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_CM_ID=
ABDM_SANDBOX_GATEWAY_URL=https://dev.abdm.gov.in
ABDM_SANDBOX_API_URL=https://abhasbx.abdm.gov.in
ABDM_PRODUCTION_GATEWAY_URL=
ABDM_PRODUCTION_API_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
VIDEO_PROVIDER=
VIDEO_API_KEY=
VIDEO_WEBHOOK_SECRET=
# Native WebRTC signaling. Configure a production TURN server for restrictive networks.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
# Optional Web Push; generate a VAPID key pair and keep the private key server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid
